# PostgreSQL / pgvector
POSTGRES_DB=cyber_threat_identifier
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cyber_threat_identifier

# LLM configuration (default: Google Gemini via OpenAI-compatible endpoint)
LLM_API_KEY=
MODEL_ID=gemini-3.1-flash-lite
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# To use another provider, set an OpenAI-compatible base URL and model ID,
# and adjust src/llm_client.py if the API differs.

# Streamlit UI
STREAMLIT_PORT=8501