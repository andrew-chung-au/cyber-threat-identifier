# Secrets and local environments
.env
.env.*
!.env.example
.venv/
venv/

# Python bytecode and tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pytype/
.ipynb_checkpoints/

# Test coverage and build artefacts
.coverage
.coverage.*
htmlcov/
dist/
build/
*.egg-info/

# Local database / Docker-related state
postgres_data/

# Logs and transient runtime output
*.log
logs/

# Raw upstream ATT&CK downloads are regenerated by the ingestion pipeline.
data/raw/attack/*.json

# Local clone used to inspect and rebuild the upstream external dataset.
data/external_inspection/

# Runtime feedback may contain user-entered incident narratives and generated answers.
data/feedback/feedback.csv

# Private expert evaluation data
data/eval/*

# Local-only evaluation outputs containing external narratives.
data/evaluation_reports/local/

# Evaluation inputs and reports are deliberately committed so reviewers can inspect
# v1 evidence and the dashboard can render without API credentials or reruns.
# Do not ignore data/eval/ or data/evaluation_reports/.

# Operating-system files
.DS_Store
Thumbs.db
desktop.ini
